{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/logos/*",
      "/mascot/*",
      "/past-edition/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,ics,html,json,txt,webmanifest,xml}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
